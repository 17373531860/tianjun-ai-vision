@echo off
chcp 65001 >nul
rem ====== TianJun 热补丁: 插件客户绑定密钥内置 (修 PLUGIN_SECRET_MISSING) ======
net session >nul 2>&1
if %errorLevel% neq 0 (
  echo 需要管理员权限写入安装目录, 正在请求提权...
  powershell -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
  exit /b
)
setlocal
set "INSTALL=C:\Program Files\tianjun-ai-vision\resources"
set "PY=%INSTALL%\python\python.exe"
set "PS=%INSTALL%\backend\core\plugin_secret.py"
set "VF=%INSTALL%\backend\plugin_system\verifier.py"
echo ============================================================
echo  TianJun 热补丁 - 内置插件客户绑定密钥
echo ============================================================
if not exist "%PY%" (
  echo 错误: 未找到 Python: %PY%
  echo 若装在其它盘, 用记事本打开本脚本修改 INSTALL 路径.
  pause & exit /b
)
echo [1/5] 关闭正在运行的天军 (释放文件占用)...
taskkill /f /im "TianJun AI Vision.exe" >nul 2>&1
for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8001 ^| findstr LISTENING') do taskkill /f /pid %%a >nul 2>&1
echo [2/5] 清理 Python 字节码缓存...
rd /s /q "%INSTALL%\backend\core\__pycache__" >nul 2>&1
rd /s /q "%INSTALL%\backend\plugin_system\__pycache__" >nul 2>&1
echo [3/5] 备份当前 verifier.py...
copy /y "%VF%" "%VF%.bak" >nul 2>&1
echo [4/5] 写入文件...
del "%TEMP%\tj_ps.b64" >nul 2>&1
echo >>"%TEMP%\tj_ps.b64"
echo >>"%TEMP%\tj_ps.b64"
"%PY%" -c "import base64;open(r'%PS%','wb').write(base64.b64decode(open(r'%TEMP%\tj_ps.b64','rb').read()))"
del "%TEMP%\tj_vf.b64" >nul 2>&1
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
echo >>"%TEMP%\tj_vf.b64"
"%PY%" -c "import base64;open(r'%VF%','wb').write(base64.b64decode(open(r'%TEMP%\tj_vf.b64','rb').read()))"
del "%TEMP%\tj_ps.b64" "%TEMP%\tj_vf.b64" >nul 2>&1
echo [5/5] 验证补丁加载...
cd /d "%INSTALL%"
"%PY%" -c "from backend.plugin_system.verifier import get_plugin_secret as g;s=g();print('  PLUGIN_SECRET 就绪:', s is not None and len(s)==32)"
echo ============================================================
echo  完成! 请重启 天军 AI Vision, 再上传插件.
echo ============================================================
pause
