# 复制为 .env 后由 docker compose 自动加载（也可手动 export）。

# ---------- PostgreSQL ----------
POSTGRES_USER=tianjun
POSTGRES_PASSWORD=tianjun_dev_pwd
POSTGRES_DB=tianjun
POSTGRES_PORT=5433

# ---------- 后端运行 ----------
# 强烈建议改用 PG，单机也行（避免 SQLite 写锁争用）
DATABASE_URL=postgresql+psycopg2://tianjun:tianjun_dev_pwd@127.0.0.1:5433/tianjun

# 可选：连接池调优
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
