{
  "name": "tianjun-ai-vision",
  "version": "3.1.2",
  "description": "天军科技AI视觉检测系统 - AI-powered machine vision detection system",
  "main": "main.js",
  "author": {
    "name": "天军科技",
    "email": "support@tianjun.tech"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.tianjun.ai-vision",
    "productName": "天军科技AI视觉检测系统",
    "copyright": "Copyright © 2024 天军科技",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend-manager.js",
      "license-manager.js",
      "splash.html",
      "shutdown.html",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "app/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*.py",
          "**/*.pyd",
          "**/*.dll",
          "**/*.cti",
          "**/*.ax",
          "**/*.ini",
          "**/*.manifest",
          "**/*.so",
          "**/*.so.*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/uploads/**",
          "!**/recordings/**",
          "!**/*.db"
        ]
      },
      {
        "from": "../python-env/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      },
      {
        "from": "drivers/CH341SER",
        "to": "drivers/CH341SER",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "executableName": "tianjun-ai-vision",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Utility",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}