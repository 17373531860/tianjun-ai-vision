# TianJun Fleet Hub 环境配置样例
# install.sh 会把本文件安装为 /etc/tianjun-hub.env (已存在则不覆盖)
# 全部变量的完整说明见 hub/README.md 第三节

# ⚠️ 首次启动播种 admin 的口令 (仅首次生效; 不设则默认 admin123, 上线必改)
HUB_ADMIN_PASSWORD=请改成强口令

# 数据目录 (hub.db + Fernet 密钥; 备份这个目录就是备份枢纽)
HUB_DATA_DIR=/var/lib/tianjun-hub

# 轮询节奏 (默认即可, 4~10 台边缘不用动)
#HUB_HEALTH_INTERVAL=2
#HUB_EVENT_INTERVAL=4
#HUB_CYCLE_INTERVAL=5

# 数据保留 (周期明细 90 天 / 小时聚合 2 年)
#HUB_CYCLE_KEEP_DAYS=90
#HUB_ROLLUP_KEEP_DAYS=730
